REACT_APP_SUPABASE_URL=https://isjfyoyzznhulymwhexx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_Nzth-CDGaG08D7N-TKjFEg_vtRJzum_

# ----------------------------------------------------------------------------
#  ABOUT THIS KEY
#
#  The anon key is designed to be public. It ships inside the JavaScript
#  bundle and every visitor to the site can read it out of the source. It
#  identifies the project; it authorises nothing. Row Level Security is what
#  protects your data — see database/policies.sql.
#
#  So this file being readable is not the risk. The real rules are:
#
#    * NEVER put the service_role key here. It bypasses RLS entirely and
#      would hand a visitor your whole database.
#    * Run database/policies.sql. Without RLS enabled, the anon key really
#      would be a master key.
#
#  .env is listed in .gitignore, so it stays out of version control anyway.
# ----------------------------------------------------------------------------
