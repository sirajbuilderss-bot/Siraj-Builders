{
  "name": "siraj-builders-website",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "node scripts/env-bridge.js && react-scripts start",
    "start": "node scripts/env-bridge.js && react-scripts start",
    "build": "node scripts/env-bridge.js && react-scripts build",
    "preview": "npx serve -s build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx",
    "verify": "node scripts/verify-static.js && node scripts/verify-sql.js",
    "verify:sql": "node scripts/verify-sql.js",
    "build:sql": "node database/build-content.cjs && node database/build-sql.js",
    "build:content": "node database/build-content.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "Siraj Builders \u2014 professional construction and building services website.",
  "homepage": "/"
}
